{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "build": "expo export --platform web",
    "expo-doctor": "expo-doctor",
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev:offline": "expo start --offline",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm --dir ../.. exec eslint -c apps/mobile/eslint.config.cjs apps/mobile/app apps/mobile/components apps/mobile/constants",
    "test": "jest --config jest.config.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@jurisly/api-client": "workspace:*",
    "@jurisly/storage": "workspace:*",
    "@jurisly/trpc": "workspace:*",
    "@jurisly/utils": "workspace:*",
    "@jurisly/vault-crypto": "workspace:*",
    "@peculiar/webcrypto": "^1.5.0",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "^8.7.0",
    "@tanstack/react-query": "^5.66.0",
    "@trpc/client": "^11.16.0",
    "@trpc/react-query": "^11.16.0",
    "expo": "~54.0.34",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.11",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "i18n-js": "^4.5.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "19.2.14",
    "eslint": "^9.39.0",
    "eslint-config-expo": "^10.0.0",
    "expo-doctor": "^1.18.18",
    "jest": "^30.4.2",
    "react-test-renderer": "19.1.0",
    "ts-jest": "^29.4.9",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "@types/react",
        "@sentry/react-native",
        "jest",
        "@types/jest"
      ]
    }
  },
  "private": true
}
