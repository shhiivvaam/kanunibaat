#!/usr/bin/env sh
# Same checks as pre-commit so a bypassed commit still cannot be pushed.
set -e
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "husky: not inside a git work tree." >&2
  exit 1
}
cd "$ROOT" || exit 1
PNPM="$ROOT/node_modules/.bin/pnpm"
if [ ! -x "$PNPM" ]; then
  echo "husky: $PNPM not found or not executable." >&2
  echo "  From repo root run: pnpm install" >&2
  echo "  (Do not use pnpm install --ignore-scripts — that skips hook setup.)" >&2
  exit 1
fi
exec "$PNPM" verify
