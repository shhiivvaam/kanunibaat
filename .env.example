# --- App URLs ---
# Production (Vercel web + Render API): see docs/DEPLOYMENT-FREE-TIER.md
#   NEXT_PUBLIC_APP_URL = https://<project>.vercel.app (or custom domain)
#   NEXT_PUBLIC_API_URL / INTERNAL_API_URL = https://<service>.onrender.com (no trailing slash)
#   CORS_ORIGIN = same origin(s) as the web app, comma-separated (include Vercel preview URLs if needed)
#   BETTER_AUTH_URL = same as NEXT_PUBLIC_APP_URL (not the API host)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: `waitlist` = single campaign landing + allowlisted routes only (middleware). Omit or any other value = full marketing site.
# NEXT_PUBLIC_MARKETING_CAMPAIGN=waitlist
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-side tRPC proxy target (Next → Nest). Defaults to NEXT_PUBLIC_API_URL when unset.
INTERNAL_API_URL=http://localhost:4000
NODE_ENV=development

# Better Auth (web + API). Generate secret: openssl rand -base64 32. Set on **both** Next and Nest so the API can unsign session cookies.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional on API: deep links (e.g. WhatsApp bot) when BETTER_AUTH_URL is unset; usually same as web canonical URL.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: comma-separated session cookie names if you customize Better Auth cookie names
# BETTER_AUTH_SESSION_COOKIE_NAMES=better-auth.session_token,__Secure-better-auth.session_token

# Database (Postgres). Supabase: Project Settings → Database → URI (use pooler in prod)
DATABASE_URL=

# Vault (API): only `stub` exists today — required in production (`loadApiEnv`) as acknowledgement that uploads are not AV-scanned yet.
VAULT_MALWARE_SCAN_PROVIDER=stub

# Supabase (client + server helpers; RLS realtime in later phases)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# API CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:3000

# API port (NestJS)
PORT=4000

# Legacy / future JWT (Phase 2+); Better Auth uses BETTER_AUTH_SECRET above
JWT_SECRET=
JWT_REFRESH_SECRET=

# SMS (MSG91) — Phase 2+
MSG91_API_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID_OTP=

# Email (Resend) — used by the **API** for waitlist notifications (web forms call the API).
# Also used by **web** Better Auth email-otp delivery when enabled.
RESEND_API_KEY=
FROM_EMAIL=
# Optional: where waitlist submissions are sent (defaults to FROM_EMAIL)
WAITLIST_NOTIFY_EMAIL=

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Storage (AWS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
CLOUDFRONT_DOMAIN=

# AI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# OCR
GOOGLE_CLOUD_VISION_API_KEY=

# Search (Meilisearch)
MEILISEARCH_URL=
MEILISEARCH_MASTER_KEY=
# Optional; defaults to "lawyers"
MEILISEARCH_INDEX_LAWYERS=
# Optional; Phase 9 judgments index — defaults to "judgments". Create index with primary key `id`; admin `reindexResearchJudgments` upserts from Postgres.
MEILISEARCH_INDEX_JUDGMENTS=

# Cache (Upstash Redis)
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Video (LiveKit)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Phase 8 — NJDG / eCourts lookup bridge (optional). POST JSON { "cnr": "..." }; returns JSON snapshot. Bearer NJDG_BRIDGE_SECRET.
NJDG_BRIDGE_URL=
NJDG_BRIDGE_SECRET=

# Sentry — Web (DSN safe to expose with restricted keys)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Sentry — API (server DSN; keep private)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

# Sentry — source maps / releases (CI)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=newsbite
SENTRY_PROJECT=jurisly

# Sentry — Mobile (Expo)
EXPO_PUBLIC_SENTRY_DSN=

# Expo / EAS — base URL of the Nest API (no trailing slash). Physical devices: use your machine LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:4000
# Web app origin for “open in browser” (Settings). Match NEXT_PUBLIC_APP_URL for local dev.
EXPO_PUBLIC_APP_URL=http://localhost:3000
EXPO_ACCESS_TOKEN=

# Sentry — Mobile (Expo)
EXPO_PUBLIC_SENTRY_DSN=

# WhatsApp (Phase 15)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
